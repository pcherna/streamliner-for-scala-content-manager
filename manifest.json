{
  "manifest_version": 3,
  "name": "Streamliner for Scala Content Manager",
  "version": "1.38.0",
  "description": "Conveniences and fixes for Scala Content Manager: dark mode, speedup, text-only menus, search hotkey, host badge, login fix.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Streamliner for Scala Content Manager"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/ContentManager/*",
        "*://*/ContentManager"
      ],
      "js": [
        "streamliner.user.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
